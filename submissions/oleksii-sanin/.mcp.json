{
  "mcpServers": {
    "ideabrowser": {
      "type": "http",
      "url": "https://www.ideabrowser.com/api/mcp/mcp",
      "headers": {
        "Authorization": "Bearer ${IDEABROWSER_API_KEY}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--secrets",
        ".env.local"
      ]
    }
  }
}
